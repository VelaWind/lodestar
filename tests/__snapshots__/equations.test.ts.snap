  "stellar-fusion/math.pp-rate.note#13": "T_6^{-2/3} = 0.159",
  "stellar-fusion/math.pp-rate.note#14": "\\varepsilon = 0.241 \\times 1.5 \\times 10^{5} \\times 0.34^2 \\times 0.159 \\times 1.4 \\times 10^{-6} = 9 \\times 10^{-4}\\,\\text{W/kg}",
  "stellar-fusion/math.pp-rate.note#2": "X",
  "stellar-fusion/math.pp-rate.note#3": "T_6",
  "stellar-fusion/math.pp-rate.note#4": "T = 1.57 \\times 10^{7}\\,\\text{K}",
  "stellar-fusion/math.pp-rate.note#5": "\\rho = 1.5 \\times 10^{5}\\,\\text{kg/m}^3",
  "stellar-fusion/math.pp-rate.note#6": "X = 0.34",
  "stellar-fusion/math.pp-rate.note#7": "kT = 8.617 \\times 10^{-5}\\,\\text{eV/K} \\times 1.57 \\times 10^{7}\\,\\text{K} = 1.35\\,\\text{keV}",
  "stellar-fusion/math.pp-rate.note#8": "E_0 = (493\\,\\text{keV} \\times (1.35\\,\\text{keV})^2 / 4)^{1/3} = (226\\,\\text{keV}^3)^{1/3} = 6.1\\,\\text{keV}",
  "stellar-fusion/math.pp-rate.note#9": "P = \\exp(-\\sqrt{493 / 6.1}) = \\exp(-9.0) = 1.2 \\times 10^{-4}",
  "stellar-fusion/math.tunnelling.note#0": "P",
  "stellar-fusion/math.tunnelling.note#1": "\\exp(-\\sqrt{E_G / E_0})",
  "stellar-fusion/math.tunnelling.note#2": "E_0",
  "stellar-fusion/math.tunnelling.note#3": "T",
  "stellar-fusion/math.tunnelling.note#4": "E_0",
  "stellar-fusion/real#0": "kT",
  "stellar-fusion/real#1": "T",
  "stellar-fusion/real#2": "k",
}
`;


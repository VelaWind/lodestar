exports[`published equations > renders every equation in both modes, unchanged 1`] = `
{
  "black-holes/schwarzschild-radius/numbers": "r_s \\;=\\; \\dfrac{2G\\,{1.99 \\times 10^{31}\\,\\mathrm{kg}}}{c^{2}}",
  "black-holes/schwarzschild-radius/symbols": "r_s \\;=\\; \\dfrac{2G\\,M}{c^{2}}",
  "black-holes/tidal-at-horizon/numbers": "\\Delta a \\;=\\; \\dfrac{2G\\,{1.99 \\times 10^{31}\\,\\mathrm{kg}}\\,h}{r_s^{3}}",
  "black-holes/tidal-at-horizon/symbols": "\\Delta a \\;=\\; \\dfrac{2G\\,M\\,h}{r_s^{3}}",
  "cosmic-microwave-background/dipole/numbers": "\\Delta T \\;=\\; \\dfrac{{2.725\\,\\mathrm{K}}\\,{3.70 \\times 10^{5}\\,\\mathrm{m/s}}}{c}",
  "cosmic-microwave-background/dipole/symbols": "\\Delta T \\;=\\; \\dfrac{T\\,v}{c}",
  "cosmic-microwave-background/temperature-redshift/numbers": "z \\;=\\; \\dfrac{{2.725\\,\\mathrm{K}}}{T_0} - 1",
  "cosmic-microwave-background/temperature-redshift/symbols": "z \\;=\\; \\dfrac{T}{T_0} - 1",
  "cosmic-microwave-background/wien-peak/numbers": "\\lambda_{\\text{peak}} \\;=\\; \\dfrac{b}{{2.725\\,\\mathrm{K}}}",
  "cosmic-microwave-background/wien-peak/symbols": "\\lambda_{\\text{peak}} \\;=\\; \\dfrac{b}{T}",
  "escape-velocity/apex/numbers": "r_{\\max} \\;=\\; \\dfrac{1}{\\dfrac{1}{{6.37 \\times 10^{6}\\,\\mathrm{m}}} \\,-\\, \\dfrac{{\\left(8000\\,\\mathrm{m/s}\\right)}^{2}}{2G\\,{5.97 \\times 10^{24}\\,\\mathrm{kg}}}}",
  "escape-velocity/apex/symbols": "r_{\\max} \\;=\\; \\dfrac{1}{\\dfrac{1}{R} \\,-\\, \\dfrac{v_0^{2}}{2G\\,M}}",
  "escape-velocity/escape-velocity/numbers": "v_{\\text{esc}} \\;=\\; \\sqrt{\\dfrac{2G\\,{5.97 \\times 10^{24}\\,\\mathrm{kg}}}{{6.37 \\times 10^{6}\\,\\mathrm{m}}}}",
  "escape-velocity/escape-velocity/symbols": "v_{\\text{esc}} \\;=\\; \\sqrt{\\dfrac{2G\\,M}{R}}",
  "exoplanets/transit-depth/numbers": "\\delta \\;=\\; \\left(\\dfrac{{6.99 \\times 10^{7}\\,\\mathrm{m}}}{{6.96 \\times 10^{8}\\,\\mathrm{m}}}\\right)^{2}",
  "exoplanets/transit-depth/symbols": "\\delta \\;=\\; \\left(\\dfrac{R_p}{R_\\star}\\right)^{2}",
  "exoplanets/transit-duration/numbers": "T \\;=\\; \\dfrac{P}{\\pi}\\,\\arcsin\\!\\left(\\dfrac{{6.96 \\times 10^{8}\\,\\mathrm{m}} + {6.99 \\times 10^{7}\\,\\mathrm{m}}}{{7.48 \\times 10^{9}\\,\\mathrm{m}}}\\right)",
  "exoplanets/transit-duration/symbols": "T \\;=\\; \\dfrac{P}{\\pi}\\,\\arcsin\\!\\left(\\dfrac{R_\\star + R_p}{a}\\right)",
  "expansion-of-the-universe/hubble-time/numbers": "t_H \\;=\\; \\dfrac{1}{{2.18 \\times 10^{-18}\\,\\mathrm{s^{-1}}}}",
  "expansion-of-the-universe/hubble-time/symbols": "t_H \\;=\\; \\dfrac{1}{H_0}",
  "expansion-of-the-universe/recession-velocity/numbers": "v \\;=\\; {2.18 \\times 10^{-18}\\,\\mathrm{s^{-1}}}\\,{3.09 \\times 10^{24}\\,\\mathrm{m}}",
  "expansion-of-the-universe/recession-velocity/symbols": "v \\;=\\; H_0\\,d",
  "expansion-of-the-universe/redshift/numbers": "z \\;=\\; \\dfrac{\\lambda_{\\text{obs}} - \\lambda_{\\text{rest}}}{\\lambda_{\\text{rest}}} \\;\\approx\\; \\dfrac{{2.18 \\times 10^{-18}\\,\\mathrm{s^{-1}}}\\,{3.09 \\times 10^{24}\\,\\mathrm{m}} + {0\\,\\mathrm{m/s}}}{c}",
  "expansion-of-the-universe/redshift/symbols": "z \\;=\\; \\dfrac{\\lambda_{\\text{obs}} - \\lambda_{\\text{rest}}}{\\lambda_{\\text{rest}}} \\;\\approx\\; \\dfrac{H_0\\,d + v_{\\text{pec}}}{c}",
  "gravitational-waves/chirp-mass/numbers": "\\mathcal{M}_c \\;=\\; \\dfrac{\\left({7.16 \\times 10^{31}\\,\\mathrm{kg}}\\,{5.77 \\times 10^{31}\\,\\mathrm{kg}}\\right)^{3/5}}{\\left({7.16 \\times 10^{31}\\,\\mathrm{kg}} + {5.77 \\times 10^{31}\\,\\mathrm{kg}}\\right)^{1/5}}",
  "gravitational-waves/chirp-mass/symbols": "\\mathcal{M}_c \\;=\\; \\dfrac{\\left(m_1\\,m_2\\right)^{3/5}}{\\left(m_1 + m_2\\right)^{1/5}}",
  "gravitational-waves/strain/numbers": "h \\;=\\; \\dfrac{4}{{1.26 \\times 10^{25}\\,\\mathrm{m}}}\\left(\\dfrac{G\\mathcal{M}_c}{c^{2}}\\right)^{5/3}\\left(\\dfrac{\\pi f}{c}\\right)^{2/3}",
  "gravitational-waves/strain/symbols": "h \\;=\\; \\dfrac{4}{d}\\left(\\dfrac{G\\mathcal{M}_c}{c^{2}}\\right)^{5/3}\\left(\\dfrac{\\pi f}{c}\\right)^{2/3}",
  "kepler-orbits/apsides/numbers": "r_p \\;=\\; {1.50 \\times 10^{11}\\,\\mathrm{m}}\\left(1 - {0.0167}\\right), \\qquad r_a \\;=\\; {1.50 \\times 10^{11}\\,\\mathrm{m}}\\left(1 + {0.0167}\\right)",
  "kepler-orbits/apsides/symbols": "r_p \\;=\\; a\\left(1 - e\\right), \\qquad r_a \\;=\\; a\\left(1 + e\\right)",
  "kepler-orbits/third-law/numbers": "T \\;=\\; 2\\pi\\sqrt{\\dfrac{{\\left(1.50 \\times 10^{11}\\,\\mathrm{m}\\right)}^{3}}{G\\,{1.99 \\times 10^{30}\\,\\mathrm{kg}}}}",
  "kepler-orbits/third-law/symbols": "T \\;=\\; 2\\pi\\sqrt{\\dfrac{a^{3}}{G\\,M}}",
  "planetary-atmospheres/retention-criterion/numbers": "v_{\\text{esc}} \\;=\\; \\sqrt{\\dfrac{2G\\,{5.97 \\times 10^{24}\\,\\mathrm{kg}}}{{6.37 \\times 10^{6}\\,\\mathrm{m}}}} \\;\\gtrsim\\; 6\\,v_{\\text{th}}",
  "planetary-atmospheres/retention-criterion/symbols": "v_{\\text{esc}} \\;=\\; \\sqrt{\\dfrac{2G\\,M}{R}} \\;\\gtrsim\\; 6\\,v_{\\text{th}}",
  "planetary-atmospheres/thermal-speed/numbers": "v_{\\text{th}} \\;=\\; \\sqrt{\\dfrac{2k_B\\,{1000\\,\\mathrm{K}}}{m}}",
  "planetary-atmospheres/thermal-speed/symbols": "v_{\\text{th}} \\;=\\; \\sqrt{\\dfrac{2k_B\\,T}{m}}",
  "scale-of-the-universe/light-crossing/numbers": "t \\;=\\; \\dfrac{{1.70\\,\\mathrm{m}}}{c}",
  "scale-of-the-universe/light-crossing/symbols": "t \\;=\\; \\dfrac{s}{c}",
  "scale-of-the-universe/rungs/numbers": "n \\;=\\; \\log_{10}\\!\\left(\\dfrac{{1.70\\,\\mathrm{m}}}{s_p}\\right)",
  "scale-of-the-universe/rungs/symbols": "n \\;=\\; \\log_{10}\\!\\left(\\dfrac{s}{s_p}\\right)",
}
`;
